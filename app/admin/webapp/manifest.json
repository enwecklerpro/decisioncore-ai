{
    "_version": "1.65.0",
    "sap.app": {
        "id": "decisioncore.admin",
        "type": "application",
        "title": "AI Provider Admin",
        "description": "Configure AI providers",
        "applicationVersion": {
            "version": "2.0.0"
        },
        "dataSources": {
            "mainService": {
                "uri": "/api/admin/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "sap-icon://settings"
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": false,
        "rootView": {
            "viewName": "decisioncore.admin.view.Main",
            "type": "XML",
            "id": "mainView"
        },
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.layout": {},
                "sap.f": {}
            }
        },
        "models": {
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server"
                }
            }
        }
    }
}