<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" 
    xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout"
    controllerName="decisioncore.admin.controller.Main" displayBlock="true">
    <App id="app">
        <f:DynamicPage headerExpanded="true" toggleHeaderOnTitleClick="true" showFooter="true">
            <f:title>
                <f:DynamicPageTitle>
                    <f:heading><Title text="AI Provider Administration"/></f:heading>
                    <f:expandedContent><Label text="Configure LLM connections"/></f:expandedContent>
                    <f:actions>
                        <Button text="Add Provider" type="Emphasized" icon="sap-icon://add" press=".onAddProvider"/>
                    </f:actions>
                </f:DynamicPageTitle>
            </f:title>
            <f:header>
                <f:DynamicPageHeader pinnable="true">
                    <layout:HorizontalLayout allowWrapping="true">
                         <layout:VerticalLayout class="sapUiMediumMarginEnd">
                            <ObjectAttribute title="Active Providers" text="4"/>
                        </layout:VerticalLayout>
                        <layout:VerticalLayout class="sapUiMediumMarginEnd">
                            <ObjectAttribute title="Default Model" text="GPT-4"/>
                        </layout:VerticalLayout>
                    </layout:HorizontalLayout>
                </f:DynamicPageHeader>
            </f:header>
            <f:content>
                <Table id="providersTable" mode="MultiSelect" items="{/AIProviders}" sticky="ColumnHeaders,HeaderToolbar" inset="false" class="sapFDynamicPageAlignContent" width="auto">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Configured Models"/>
                            <ToolbarSpacer/>
                            <SearchField width="200px" search=".onSearch"/>
                            <Button icon="sap-icon://delete" type="Transparent" text="Delete Selected" press=".onDeleteSelectedProviders"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column><Text text="Provider Code"/></Column>
                        <Column><Text text="Name"/></Column>
                        <Column><Text text="Type"/></Column>
                        <Column><Text text="Status"/></Column>
                        <Column hAlign="Center"><Text text="Default"/></Column>
                        <Column hAlign="End"><Text text="Actions"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier title="{code}"/>
                                <Text text="{name}"/>
                                <ObjectStatus text="{providerType}" state="Information" inverted="true"/>
                                <ObjectStatus text="{status}" state="{= ${status} === 'ACTIVE' ? 'Success' : 'Warning'}" icon="{= ${status} === 'ACTIVE' ? 'sap-icon://connected' : 'sap-icon://disconnected'}"/>
                                <VBox>
                                    <core:Icon src="{= ${isDefault} ? 'sap-icon://accept' : ''}" color="Positive"/>
                                    <Button text="Test" icon="sap-icon://connected" press=".onTestConnection"/>
                                </VBox>
                                <Button icon="sap-icon://edit" type="Transparent" press=".onEditProvider"/>
                                <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteProvider"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </f:content>
            <f:footer>
                <OverflowToolbar>
                    <ToolbarSpacer/>
                    <Text text="DecisionCore AI - Created by Taha Khattari"/>
                    <ToolbarSpacer/>
                </OverflowToolbar>
            </f:footer>
        </f:DynamicPage>
    </App>
</mvc:View>
