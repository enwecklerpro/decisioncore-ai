<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:l="sap.ui.layout" 
    xmlns:core="sap.ui.core" xmlns:cards="sap.f.cards" xmlns:html="http://www.w3.org/1999/xhtml"
    controllerName="decisioncore.dashboard.controller.Dashboard" displayBlock="true">
    
    <App id="app" busy="{dashboard>/loading}">
        <pages>
            <Page showHeader="false" enableScrolling="true" class="sapUiContentPadding">
                
                <content>
                    <!-- KEY METRICS ROW -->
                    <l:Grid defaultSpan="XL3 L3 M6 S12" class="sapUiMediumMarginTop">
                        
                        <!-- 1. TOTAL DECISIONS -->
                        <f:Card class="dashboardCard border-blue">
                            <f:content>
                                <VBox class="sapUiMediumMargin">
                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="TOTAL DECISIONS" class="kpi-label"/>
                                        <core:Icon src="sap-icon://line-charts" color="#0070f2"/>
                                    </HBox>
                                    <Text text="{path: 'dashboard>/stats/totalDecisions', formatter: '.formatNumber'}" class="kpi-h1 sapUiTinyMarginTop"/>
                                    <ObjectStatus text="+12% vs last week" state="Success" icon="sap-icon://trend-up" class="sapUiTinyMarginTop"/>
                                </VBox>
                            </f:content>
                        </f:Card>
                        
                        <!-- 2. APPROVAL RATE -->
                        <f:Card class="dashboardCard border-green">
                            <f:content>
                                <VBox class="sapUiMediumMargin">
                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="APPROVAL RATE" class="kpi-label"/>
                                        <core:Icon src="sap-icon://accept" color="#107e3e"/>
                                    </HBox>
                                    <Text text="{dashboard>/stats/approvalRate}%" class="kpi-h1 sapUiTinyMarginTop"/>
                                    <ProgressIndicator percentValue="{dashboard>/stats/approvalRate}" state="Success" displayValue="" height="6px" class="sapUiSmallMarginTop"/>
                                </VBox>
                            </f:content>
                        </f:Card>
                        
                        <!-- 3. AUTOMATION RATE (Derived from AI) -->
                        <f:Card class="dashboardCard border-teal">
                            <f:content>
                                <VBox class="sapUiMediumMargin">
                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="AVG CONFIDENCE" class="kpi-label"/>
                                        <core:Icon src="sap-icon://robot" color="#008f8f"/>
                                    </HBox>
                                    <Text text="{dashboard>/stats/avgConfidence}%" class="kpi-h1 sapUiTinyMarginTop"/>
                                    <ProgressIndicator percentValue="{dashboard>/stats/avgConfidence}" state="Information" displayValue="" height="6px" class="sapUiSmallMarginTop"/>
                                </VBox>
                            </f:content>
                        </f:Card>
                        
                        <!-- 4. REJECTION RATE -->
                        <f:Card class="dashboardCard border-orange">
                            <f:content>
                                <VBox class="sapUiMediumMargin">
                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="REJECTION RATE" class="kpi-label"/>
                                        <core:Icon src="sap-icon://decline" color="#bb0000"/>
                                    </HBox>
                                    <Text text="{dashboard>/stats/rejectionRate}%" class="kpi-h1 sapUiTinyMarginTop"/>
                                    <ObjectStatus text="Requires attention" state="Warning" icon="sap-icon://alert" class="sapUiTinyMarginTop"/>
                                </VBox>
                            </f:content>
                        </f:Card>
                    </l:Grid>
                    
                    <!-- CHARTS ROW -->
                    <l:Grid defaultSpan="XL4 L4 M12 S12" class="sapUiTinyMarginTop">
                        
                        <!-- DONUT CHART: Decision Distribution -->
                        <f:Card class="dashboardCard" height="340px">
                            <f:header>
                                <cards:Header title="Decision Outcomes" subtitle="Distribution of results"/>
                            </f:header>
                            <f:content>
                                <VBox alignItems="Center" justifyContent="Center" height="100%">
                                    <!-- CSS Donut Chart Injected Here -->
                                    <html:div class="donut-chart-container">
                                        <html:div class="donut-chart" style="background: {dashboard>/chartData/donutGradient}"></html:div>
                                        <html:div class="donut-center-text">
                                            <html:div class="donut-number">{dashboard>/stats/totalDecisions}</html:div>
                                            <html:div style="font-size:0.8rem; color:#666;">Total</html:div>
                                        </html:div>
                                    </html:div>
                                    
                                    <!-- Custom Legend -->
                                    <HBox class="sapUiMediumMarginTop" justifyContent="Center" wrap="Wrap">
                                        <HBox alignItems="Center" class="sapUiMediumMarginEnd">
                                            <html:div class="legend-dot dot-green"></html:div>
                                            <Text text="Approved ({dashboard>/stats/approvalRate}%)"/>
                                        </HBox>
                                        <HBox alignItems="Center" class="sapUiMediumMarginEnd">
                                            <html:div class="legend-dot dot-red"></html:div>
                                            <Text text="Rejected ({dashboard>/stats/rejectionRate}%)"/>
                                        </HBox>
                                        <HBox alignItems="Center">
                                            <html:div class="legend-dot dot-orange"></html:div>
                                            <Text text="Review ({dashboard>/stats/reviewRate}%)"/>
                                        </HBox>
                                    </HBox>
                                </VBox>
                            </f:content>
                        </f:Card>

                         <!-- SCORE CONTRIBUTION -->
                        <f:Card class="dashboardCard" height="340px">
                            <f:header>
                                <cards:Header title="Score Contribution" subtitle="Impact factors"/>
                            </f:header>
                            <f:content>
                                <VBox class="sapUiMediumMargin">
                                    <VBox class="sapUiSmallMarginBottom">
                                        <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                            <Title text="Business Rules Engine" level="H5"/>
                                            <Text text="{dashboard>/stats/rulesContribution}%" design="Bold"/>
                                        </HBox>
                                        <ProgressIndicator percentValue="{dashboard>/stats/rulesContribution}" state="Success" displayValue="" height="8px"/>
                                        <Text text="Deterministic rules based on policy" class="sapUiTinyMarginTop" style="color:#888; font-size:0.8rem;"/>
                                    </VBox>
                                    
                                    <VBox class="sapUiMediumMarginTop">
                                        <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                            <Title text="AI Semantic Scoring" level="H5"/>
                                            <Text text="{dashboard>/stats/aiContribution}%" design="Bold"/>
                                        </HBox>
                                        <ProgressIndicator percentValue="{dashboard>/stats/aiContribution}" state="Information" displayValue="" height="8px"/>
                                        <Text text="LLM based analysis of unstructured data" class="sapUiTinyMarginTop" style="color:#888; font-size:0.8rem;"/>
                                    </VBox>
                                    
                                    <HBox class="sapUiLargeMarginTop" alignItems="Center">
                                        <core:Icon src="sap-icon://hint" color="#0070f2" class="sapUiSmallMarginEnd"/>
                                        <Text text="AI contribution has increased by 5% this week due to improved prompt templates." wrapping="true" style="font-style:italic; color:#666;"/>
                                    </HBox>
                                </VBox>
                            </f:content>
                        </f:Card>
                        
                        <!-- RECENT ALERTS (Placeholder for professional look) -->
                        <f:Card class="dashboardCard" height="340px">
                             <f:header>
                                <cards:Header title="System Status" subtitle="Operational health"/>
                            </f:header>
                            <f:content>
                                <List showSeparators="Inner" class="sapUiContentPadding">
                                    <StandardListItem title="API Latency" description="Optimum (145ms)" icon="sap-icon://performance" info="Good" infoState="Success"/>
                                    <StandardListItem title="Rule Engine v2.1" description="Active" icon="sap-icon://puzzle" info="Active" infoState="Success"/>
                                    <StandardListItem title="AI Model: GPT-4" description="Connected" icon="sap-icon://cloud" info="Online" infoState="Success"/>
                                    <StandardListItem title="Decision Logging" description="Audit enabled" icon="sap-icon://log" info="Enabled" infoState="Success"/>
                                </List>
                            </f:content>
                        </f:Card>

                    </l:Grid>
                    
                    <!-- TABLE SECTION -->
                    <l:Grid defaultSpan="XL12 L12 M12 S12">
                        <f:Card class="dashboardCard">
                            <f:header>
                                <cards:Header title="Top Triggered Business Rules" subtitle="Performance analysis" iconSrc="sap-icon://list"/>
                            </f:header>
                            <f:content>
                                <Table items="{dashboard>/topRules}" inset="false" fixedLayout="false">
                                    <columns>
                                        <Column width="150px"><Text text="Rule ID" style="font-weight:600; color:#888;"/></Column>
                                        <Column><Text text="Description" style="font-weight:600; color:#888;"/></Column>
                                        <Column hAlign="End" width="100px"><Text text="Triggers" style="font-weight:600; color:#888;"/></Column>
                                        <Column hAlign="Center" width="120px"><Text text="Rate" style="font-weight:600; color:#888;"/></Column>
                                        <Column hAlign="Center" width="100px"><Text text="Impact" style="font-weight:600; color:#888;"/></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <ObjectStatus text="{dashboard>ruleCode}" state="None" inverted="true"/>
                                                <Text text="{dashboard>ruleName}" design="Bold"/>
                                                <Text text="{dashboard>triggerCount}"/>
                                                <ProgressIndicator percentValue="{dashboard>triggerRate}" displayValue="{dashboard>triggerRate}%" state="None"/>
                                                <ObjectStatus text="{path: 'dashboard>avgImpact'} pts" 
                                                       state="{= ${dashboard>avgImpact} > 0 ? 'Success' : 'Error'}"
                                                       inverted="true"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </f:content>
                        </f:Card>
                    
                    </l:Grid>
                </content>
            </Page>
        </pages>
    </App>
</mvc:View>
