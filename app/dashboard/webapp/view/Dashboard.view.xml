<mvc:View xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m" 
    xmlns:f="sap.f" 
    xmlns:l="sap.ui.layout" 
    xmlns:core="sap.ui.core" 
    xmlns:cards="sap.f.cards"
    controllerName="decisioncore.dashboard.controller.Dashboard" 
    displayBlock="true">
    
    <App>
        <f:DynamicPage headerExpanded="true" toggleHeaderOnTitleClick="true" showFooter="true" fitContent="true">
            <!-- Title -->
            <f:title>
                <f:DynamicPageTitle>
                    <f:heading>
                        <Title text="Executive Dashboard"/>
                    </f:heading>
                    <f:expandedContent>
                         <Label text="Real-time decision intelligence analytics"/>
                    </f:expandedContent>
                    <f:actions>
                        <Button icon="sap-icon://refresh" press=".onRefresh" text="Refresh Data" type="Transparent"/>
                        <Button icon="sap-icon://action-settings" type="Transparent"/>
                    </f:actions>
                </f:DynamicPageTitle>
            </f:title>

            <!-- Header Content -->
            <f:header>
                <f:DynamicPageHeader pinnable="true">
                    <l:HorizontalLayout allowWrapping="true">
                        <f:Avatar src="sap-icon://bbyd-dashboard" displaySize="L" class="sapUiMediumMarginEnd"/>
                        <l:VerticalLayout class="sapUiMediumMarginEnd">
                             <ObjectAttribute title="System Health" text="Optimal"/>
                             <ObjectAttribute title="AI Latency" text="145ms"/>
                        </l:VerticalLayout>
                    </l:HorizontalLayout>
                </f:DynamicPageHeader>
            </f:header>

            <!-- Main Content -->
            <f:content>
                <VBox class="sapUiSmallMargin">
                    
                    <!-- KPIs Row -->
                    <Title text="Key Performance Indicators" level="H4" class="sapUiSmallMarginBottom"/>
                    <l:Grid defaultSpan="XL3 L3 M6 S12" class="sapUiSmallMarginBottom">
                        
                        <!-- Total Decisions -->
                        <f:Card>
                            <f:header>
                                <cards:Header title="Total Decisions" subtitle="All time" iconSrc="sap-icon://line-charts"/>
                            </f:header>
                            <f:content>
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMargin">
                                    <Title text="{dashboard>/stats/totalDecisions}" titleStyle="H2"/>
                                    <ObjectStatus text="+12%" state="Success" icon="sap-icon://trend-up"/>
                                </HBox>
                            </f:content>
                        </f:Card>

                        <!-- Approval Rate -->
                        <f:Card>
                            <f:header>
                                <cards:Header title="Approval Rate" subtitle="Automation" iconSrc="sap-icon://accept"/>
                            </f:header>
                            <f:content>
                                <VBox class="sapUiMediumMargin">
                                    <Title text="{dashboard>/stats/approvalRate}%" titleStyle="H2"/>
                                    <ProgressIndicator percentValue="{dashboard>/stats/approvalRate}" state="Success" displayValue="" height="0.5rem"/>
                                </VBox>
                            </f:content>
                        </f:Card>

                        <!-- Avg Confidence -->
                        <f:Card>
                            <f:header>
                                <cards:Header title="Avg Confidence" subtitle="AI Reliability" iconSrc="sap-icon://lab"/>
                            </f:header>
                            <f:content>
                                <VBox class="sapUiMediumMargin">
                                    <Title text="{dashboard>/stats/avgConfidence}%" titleStyle="H2"/>
                                    <ProgressIndicator percentValue="{dashboard>/stats/avgConfidence}" state="Information" displayValue="" height="0.5rem"/>
                                </VBox>
                            </f:content>
                        </f:Card>

                        <!-- Processing Time -->
                        <f:Card>
                            <f:header>
                                <cards:Header title="Avg Processing" subtitle="Performance" iconSrc="sap-icon://performance"/>
                            </f:header>
                            <f:content>
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMargin">
                                    <Title text="145 ms" titleStyle="H2"/>
                                    <ObjectStatus text="Optimum" state="Success"/>
                                </HBox>
                            </f:content>
                        </f:Card>

                    </l:Grid>

                    <!-- Analytics Section -->
                    <Title text="Decision Analytics" level="H4" class="sapUiSmallMarginTop sapUiSmallMarginBottom"/>
                    <l:Grid defaultSpan="XL6 L6 M12 S12">
                        
                        <!-- Outcomes Distribution -->
                        <f:Card width="100%">
                            <f:header>
                                <cards:Header title="Decision Outcomes" subtitle="Distribution"/>
                            </f:header>
                            <f:content>
                                <VBox class="sapUiMediumMargin">
                                    <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                        <Label text="Approved"/>
                                        <Label text="68%"/>
                                    </HBox>
                                    <ProgressIndicator percentValue="68" state="Success" height="0.5rem" class="sapUiSmallMarginBottom"/>
                                    
                                    <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                        <Label text="Rejected"/>
                                        <Label text="24%"/>
                                    </HBox>
                                    <ProgressIndicator percentValue="24" state="Error" height="0.5rem" class="sapUiSmallMarginBottom"/>

                                    <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                        <Label text="Review"/>
                                        <Label text="8%"/>
                                    </HBox>
                                    <ProgressIndicator percentValue="8" state="Warning" height="0.5rem"/>
                                </VBox>
                            </f:content>
                        </f:Card>

                        <!-- Score Contribution -->
                        <f:Card width="100%">
                            <f:header>
                                <cards:Header title="Score Contribution" subtitle="Rules vs AI"/>
                            </f:header>
                            <f:content>
                                <VBox class="sapUiMediumMargin">
                                    <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                        <Label text="Business Rules Engine"/>
                                        <Label text="65%"/>
                                    </HBox>
                                    <ProgressIndicator percentValue="65" state="Success" height="0.5rem" class="sapUiSmallMarginBottom"/>

                                    <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                        <Label text="AI Semantic Scoring"/>
                                        <Label text="35%"/>
                                    </HBox>
                                    <ProgressIndicator percentValue="35" state="Information" height="0.5rem"/>
                                </VBox>
                            </f:content>
                        </f:Card>
                    </l:Grid>

                    <!-- Top Rules Table -->
                    <Title text="Top Performing Rules" level="H4" class="sapUiSmallMarginTop sapUiSmallMarginBottom"/>
                    <Table items="{dashboard>/topRules}" inset="false" class="sapUiSmallMarginBottom">
                        <columns>
                            <Column width="12rem"><Text text="Rule Code"/></Column>
                            <Column><Text text="Description"/></Column>
                            <Column width="6rem" hAlign="End"><Text text="Triggers"/></Column>
                            <Column width="6rem" hAlign="End"><Text text="Rate"/></Column>
                            <Column width="6rem" hAlign="End"><Text text="Impact"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="{dashboard>ruleCode}"/>
                                    <Text text="{dashboard>ruleName}"/>
                                    <ObjectNumber number="{dashboard>triggerCount}"/>
                                    <Text text="{dashboard>triggerRate}%"/>
                                    <ObjectStatus text="{dashboard>avgImpact} pts" state="{= ${dashboard>avgImpact} > 0 ? 'Success' : 'Error'}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                </VBox>
            </f:content>

            <f:footer>
                <OverflowToolbar>
                    <ToolbarSpacer/>
                    <Text text="DecisionCore AI - Created by Taha Khattari"/>
                    <ToolbarSpacer/>
                </OverflowToolbar>
            </f:footer>
        </f:DynamicPage>
    </App>
</mvc:View>
