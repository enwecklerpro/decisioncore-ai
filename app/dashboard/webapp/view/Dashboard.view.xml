<mvc:View xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m" 
    xmlns:f="sap.f" 
    xmlns:l="sap.ui.layout" 
    xmlns:core="sap.ui.core" 
    xmlns:cards="sap.f.cards"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    controllerName="decisioncore.dashboard.controller.Dashboard" 
    displayBlock="true">
    
    <f:DynamicPage id="page" fitContent="true" class="sapUiNoContentPadding">
        
        <!-- Header -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Executive Dashboard"/>
                </f:heading>
                <f:expandedContent>
                    <Label text="Decision Intelligence Overview"/>
                </f:expandedContent>
                <f:snappedContent>
                    <Label text="Decision Intelligence Overview"/>
                </f:snappedContent>
                <f:actions>
                    <Button icon="sap-icon://refresh" type="Transparent" press=".onRefresh"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <!-- Content -->
        <f:content>
            <VBox class="sapUiSmallMargin">
                
                <!-- KPIs Row -->
                <l:Grid defaultSpan="XL3 L3 M6 S12" class="sapUiSmallMarginBottom">
                    <!-- Total Decisions -->
                    <f:Card>
                        <f:header>
                            <cards:Header title="Total Decisions" subtitle="All time" iconSrc="sap-icon://line-charts"/>
                        </f:header>
                        <f:content>
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMargin">
                                <Title text="{path: 'dashboard>/stats/totalDecisions', formatter: '.formatNumber'}" titleStyle="H2"/>
                                <ObjectStatus text="+12%" state="Success" icon="sap-icon://trend-up"/>
                            </HBox>
                        </f:content>
                    </f:Card>

                    <!-- Approval Rate -->
                    <f:Card>
                        <f:header>
                            <cards:Header title="Approval Rate" subtitle="Automation Level" iconSrc="sap-icon://accept"/>
                        </f:header>
                        <f:content>
                            <VBox class="sapUiMediumMargin">
                                <Title text="{dashboard>/stats/approvalRate}%" titleStyle="H2"/>
                                <ProgressIndicator percentValue="{dashboard>/stats/approvalRate}" state="Success" displayValue="" height="0.5rem"/>
                            </VBox>
                        </f:content>
                    </f:Card>

                    <!-- Avg Confidence -->
                    <f:Card>
                        <f:header>
                            <cards:Header title="Avg Confidence" subtitle="AI Reliability" iconSrc="sap-icon://robot"/>
                        </f:header>
                        <f:content>
                            <VBox class="sapUiMediumMargin">
                                <Title text="{dashboard>/stats/avgConfidence}%" titleStyle="H2"/>
                                <ProgressIndicator percentValue="{dashboard>/stats/avgConfidence}" state="Information" displayValue="" height="0.5rem"/>
                            </VBox>
                        </f:content>
                    </f:Card>

                     <!-- Response Time -->
                    <f:Card>
                        <f:header>
                            <cards:Header title="Avg Processing" subtitle="Performance" iconSrc="sap-icon://time-overtime"/>
                        </f:header>
                        <f:content>
                             <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMargin">
                                <Title text="{dashboard>/stats/avgProcessingMs} ms" titleStyle="H2"/>
                                <ObjectStatus text="Optimum" state="Success"/>
                            </HBox>
                        </f:content>
                    </f:Card>
                </l:Grid>

                <!-- Charts Row -->
                 <l:Grid defaultSpan="XL6 L6 M12 S12">
                     <!-- Decision Distribution Chart -->
                    <f:Card height="400px">
                        <f:header>
                            <cards:Header title="Decision Outcomes" subtitle="Status Distribution"/>
                        </f:header>
                        <f:content>
                            <viz:VizFrame id="idVizFramePie" uiConfig="{applicationSet:'fiori'}" height="100%" width="100%" vizType="donut">
                                <viz:dataset>
                                    <viz.data:FlattenedDataset data="{dashboard>/vizData/decisions}">
                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition name="Status" value="{Status}" />
                                        </viz.data:dimensions>
                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition name="Count" value="{Count}" />
                                        </viz.data:measures>
                                    </viz.data:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <viz.feeds:FeedItem uid="size" type="Measure" values="Count" />
                                    <viz.feeds:FeedItem uid="color" type="Dimension" values="Status" />
                                </viz:feeds>
                            </viz:VizFrame>
                        </f:content>
                    </f:Card>

                    <!-- Score Contribution -->
                    <f:Card height="400px">
                        <f:header>
                             <cards:Header title="Score Contribution" subtitle="Rules vs AI"/>
                        </f:header>
                        <f:content>
                            <VBox class="sapUiMediumMargin">
                                 <!-- Simple Progress Bars instead of VizFrame for cleaner comparison -->
                                <Label text="Business Rules Engine" design="Bold" class="sapUiSmallMarginBottom"/>
                                <ProgressIndicator percentValue="{dashboard>/stats/rulesContribution}" displayValue="{dashboard>/stats/rulesContribution}%" state="Success" height="1.5rem" class="sapUiMediumMarginBottom"/>

                                <Label text="AI Scoring Model" design="Bold" class="sapUiSmallMarginBottom"/>
                                <ProgressIndicator percentValue="{dashboard>/stats/aiContribution}" displayValue="{dashboard>/stats/aiContribution}%" state="Information" height="1.5rem"/>
                                
                                <MessageStrip text="AI contribution stable within tolerance limits." type="Information" showIcon="true" class="sapUiMediumMarginTop"/>
                            </VBox>
                        </f:content>
                    </f:Card>
                </l:Grid>

                <!-- Tables Row -->
                <Title text="Top Performing Rules" level="H3" class="sapUiSmallMarginTop sapUiSmallMarginBottom"/>
                <Table items="{dashboard>/topRules}" growing="true" inset="false" class="sapUiSmallMarginBottom">
                    <columns>
                        <Column width="20%"><Text text="Rule Code"/></Column>
                        <Column><Text text="Description"/></Column>
                        <Column width="15%" hAlign="Center"><Text text="Triggers"/></Column>
                        <Column width="15%" hAlign="Center"><Text text="Rate"/></Column>
                        <Column width="15%" hAlign="End"><Text text="Impact"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier title="{dashboard>ruleCode}"/>
                                <Text text="{dashboard>ruleName}"/>
                                <ObjectNumber number="{dashboard>triggerCount}"/>
                                <Text text="{dashboard>triggerRate}%"/>
                                <ObjectStatus text="{dashboard>avgImpact} pts" state="{= ${dashboard>avgImpact} > 0 ? 'Success' : 'Error'}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </f:content>

    </f:DynamicPage>
</mvc:View>
