<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core" xmlns:ce="sap.ui.codeeditor"
    controllerName="decisioncore.execute.controller.Main" displayBlock="true">
    
    <f:DynamicPage fitContent="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading><Title text="Decision Execution"/></f:heading>
                <f:actions>
                    <Button text="Load Samples" icon="sap-icon://sys-help-2" press=".onLoadSample"/>
                    <Button text="Clear" icon="sap-icon://reset" press=".onClear"/>
                    <Button text="Execute Decision" type="Emphasized" icon="sap-icon://media-play" press=".onEvaluate"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        
        <f:content>
            <l:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="1" vSpacing="1">
                
                <!-- LEFT: INPUT -->
                <VBox class="sapUiSmallMargin">
                    <Panel headerText="Input Parameters" expandable="false" width="100%">
                        <VBox class="sapUiSmallMargin">
                            
                            <Label text="Scenario" required="true"/>
                            <Select selectedKey="{view>/scenario}" forceSelection="false" width="100%"
                                items="{
                                    path: '/Scenarios',
                                    sorter: { path: 'displayName' }
                                }">
                                <core:Item key="{name}" text="{displayName} ({name})"/>
                            </Select>
                            
                            <Label text="Correlation ID" class="sapUiSmallMarginTop"/>
                            <Input value="{view>/correlationId}" placeholder="Trace ID (optional)"/>
                            
                            <Label text="Payload (JSON)" class="sapUiSmallMarginTop" required="true"/>
                            <ce:CodeEditor 
                                value="{view>/payload}" 
                                type="json" 
                                height="400px" 
                                showLanguageButtons="false"
                                valueSelection="true"
                                maxLines="30"
                                colorTheme="chrome"/>
                        </VBox>
                    </Panel>
                </VBox>
                
                <!-- RIGHT: RESULT -->
                <VBox class="sapUiSmallMargin">
                    <Panel headerText="Decision Result" expandable="false" width="100%" height="auto">
                        
                        <!-- Empty State -->
                        <IllustratedMessage illustrationType="sapIllus-EmptyList" title="No Result" description="Run a simulation to see decision details"
                            visible="{= !${view>/hasResult}}"/>
                            
                        <!-- Result State -->
                        <VBox visible="{view>/hasResult}">
                            
                            <!-- Main Outcome Banner -->
                            <MessageStrip 
                                text="Decision: {view>/result/decision}" 
                                type="{= ${view>/result/decision} === 'APPROVED' ? 'Success' : ${view>/result/decision} === 'REJECTED' ? 'Error' : 'Warning'}" 
                                showIcon="true" 
                                class="sapUiMediumMarginBottom"/>
                            
                            <!-- Key Metrics -->
                            <l:Grid defaultSpan="XL6 L6 M6 S12">
                                <VBox>
                                    <Label text="Confidence Score"/>
                                    <ObjectStatus text="{view>/result/confidence}%" state="Information" icon="sap-icon://lab"/>
                                </VBox>
                                <VBox>
                                    <Label text="Processing Time"/>
                                    <Text text="{view>/result/processingTime} ms"/>
                                </VBox>
                            </l:Grid>
                            
                            <List headerText="Logic Trace">
                                <StandardListItem title="Business Score" description="Calculated from Rules" info="{view>/result/rulesScore}" infoState="Success" icon="sap-icon://business-objects-experience"/>
                                <StandardListItem title="AI Score" description="Semantic Analysis" info="{view>/result/aiScore}" infoState="Information" icon="sap-icon://machine-learning"/>
                            </List>
                            
                            <!-- Explainability -->
                            <Panel headerText="Explanation" expandable="true" expanded="true" class="sapUiMediumMarginTop">
                                <Text text="{view>/result/explanation}" wrapping="true"/>
                            </Panel>

                            <!-- Raw JSON Output -->
                             <Panel headerText="Raw Response" expandable="true" expanded="false" class="sapUiSmallMarginTop">
                                <ce:CodeEditor 
                                    value="{view>/result/rawJson}" 
                                    type="json" 
                                    readOnly="true" 
                                    height="200px"
                                    showLanguageButtons="false"/>
                             </Panel>

                        </VBox>
                    </Panel>
                </VBox>

            </l:Grid>
        </f:content>
    </f:DynamicPage>
</mvc:View>
