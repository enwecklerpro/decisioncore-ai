<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core"
    controllerName="decisioncore.execute.controller.Main" displayBlock="true">
    
    <App>
        <f:DynamicPage headerExpanded="true" toggleHeaderOnTitleClick="true" showFooter="true" fitContent="true">
             <f:title>
                <f:DynamicPageTitle>
                    <f:heading>
                        <Title text="Decision Execution"/>
                    </f:heading>
                    <f:expandedContent>
                         <Label text="Simulate and test decision logic with real-time feedback"/>
                    </f:expandedContent>
                    <f:actions>
                        <Button text="Load Sample" icon="sap-icon://sys-help-2" press=".onLoadSample"/>
                        <Button text="Clear" icon="sap-icon://reset" press=".onClear"/>
                        <Button text="Execute" type="Emphasized" icon="sap-icon://media-play" press=".onEvaluate"/>
                    </f:actions>
                </f:DynamicPageTitle>
            </f:title>

            <f:header>
                <f:DynamicPageHeader pinnable="true">
                     <l:HorizontalLayout allowWrapping="true">
                        <l:VerticalLayout class="sapUiMediumMarginEnd">
                             <ObjectAttribute title="Selected Scenario" text="{view>/scenario}"/>
                        </l:VerticalLayout>
                        <l:VerticalLayout class="sapUiMediumMarginEnd">
                             <ObjectAttribute title="Trace Status" text="Active"/>
                        </l:VerticalLayout>
                    </l:HorizontalLayout>
                </f:DynamicPageHeader>
            </f:header>

            <f:content>
                <l:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMarginTop">
                    
                    <!-- LEFT: INPUT -->
                    <VBox class="sapUiSmallMargin">
                        <Panel headerText="Input Parameters" expandable="false" width="auto" class="sapUiResponsiveMargin">
                            <VBox class="sapUiSmallMargin">
                                
                                <Label text="Scenario" required="true"/>
                                <Select id="scenarioSelect" selectedKey="{view>/scenario}" forceSelection="false" width="100%">
                                    <core:Item key="credit-risk" text="Credit Risk Assessment"/>
                                    <core:Item key="fraud-detection" text="Fraud Detection"/>
                                    <core:Item key="vendor-risk" text="Vendor Risk Rating"/>
                                </Select>
                                
                                <Label text="Correlation ID" class="sapUiSmallMarginTop"/>
                                <Input value="{view>/correlationId}" placeholder="Trace ID (optional)"/>
                                
                                <Label text="Payload (JSON)" class="sapUiSmallMarginTop" required="true"/>
                                <TextArea value="{view>/payload}" rows="15" width="100%" placeholder="Enter JSON payload..." growing="true"/>
                            </VBox>
                        </Panel>
                    </VBox>
                    
                    <!-- RIGHT: RESULT -->
                    <VBox class="sapUiSmallMargin">
                        <Panel headerText="Decision Result" expandable="false" width="auto" class="sapUiResponsiveMargin">
                            
                            <!-- Empty State -->
                            <IllustratedMessage illustrationType="sapIllus-EmptyList" title="No Result" description="Run a simulation to see decision details"
                                visible="{= !${view>/hasResult}}"/>
                                
                            <!-- Result State -->
                            <VBox visible="{view>/hasResult}" class="sapUiSmallMargin">
                                
                                <!-- Main Outcome Banner -->
                                <ObjectStatus 
                                    text="Decision: {view>/result/decision}" 
                                    state="{= ${view>/result/decision} === 'APPROVED' ? 'Success' : ${view>/result/decision} === 'REJECTED' ? 'Error' : 'Warning'}" 
                                    icon="sap-icon://complete"
                                    class="sapUiSmallMarginBottom sapMObjectStatusLarge"/>
                                
                                <!-- Key Metrics -->
                                <l:Grid defaultSpan="XL6 L6 M6 S12" class="sapUiSmallMarginTop">
                                    <VBox>
                                        <Label text="Confidence Score"/>
                                        <ObjectStatus text="{view>/result/confidence}%" state="Information" icon="sap-icon://lab"/>
                                    </VBox>
                                    <VBox>
                                        <Label text="Processing Time"/>
                                        <Text text="{view>/result/processingTime} ms"/>
                                    </VBox>
                                </l:Grid>
                                
                                <List headerText="Logic Trace" class="sapUiSmallMarginTop" inset="false">
                                    <StandardListItem title="Business Score" description="Calculated from Rules" info="{view>/result/rulesScore}" infoState="Success" icon="sap-icon://business-objects-experience"/>
                                    <StandardListItem title="AI Score" description="Semantic Analysis" info="{view>/result/aiScore}" infoState="Information" icon="sap-icon://machine-learning"/>
                                </List>
                                
                                <!-- Explainability -->
                                <Panel headerText="Explanation" expandable="true" expanded="true" class="sapUiSmallMarginTop">
                                    <Text text="{view>/result/explanation}" wrapping="true"/>
                                </Panel>

                                <!-- Raw JSON Output -->
                                <Panel headerText="Raw Response" expandable="true" expanded="false" class="sapUiSmallMarginTop">
                                    <TextArea value="{view>/result/rawJson}" rows="8" width="100%" editable="false"/>
                                </Panel>

                            </VBox>
                        </Panel>
                    </VBox>

                </l:Grid>
            </f:content>

            <f:footer>
                <OverflowToolbar>
                    <ToolbarSpacer/>
                    <Text text="DecisionCore AI - Created by Taha Khattari"/>
                    <ToolbarSpacer/>
                </OverflowToolbar>
            </f:footer>
        </f:DynamicPage>
    </App>
</mvc:View>
