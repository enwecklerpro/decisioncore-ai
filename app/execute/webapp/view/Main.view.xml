<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core"
    controllerName="decisioncore.execute.controller.Main" displayBlock="true">
    
    <App>
        <f:DynamicPage headerExpanded="true" toggleHeaderOnTitleClick="true" showFooter="true" fitContent="true">
             <f:title>
                <f:DynamicPageTitle>
                    <f:heading>
                        <Title text="Decision Execution"/>
                    </f:heading>
                    <f:expandedContent>
                         <Label text="Simulate and test decision logic with real-time feedback"/>
                    </f:expandedContent>
                    <f:actions>
                        <Button text="Load Sample" icon="sap-icon://sys-help-2" press=".onLoadSample"/>
                        <Button text="Clear" icon="sap-icon://reset" press=".onClear"/>
                        <Button text="Execute" type="Emphasized" icon="sap-icon://media-play" press=".onEvaluate"/>
                    </f:actions>
                </f:DynamicPageTitle>
            </f:title>

            <f:header>
                <f:DynamicPageHeader pinnable="true">
                     <l:HorizontalLayout allowWrapping="true">
                        <l:VerticalLayout class="sapUiMediumMarginEnd">
                             <ObjectAttribute title="Selected Scenario" text="{view>/scenario}"/>
                        </l:VerticalLayout>
                        <l:VerticalLayout class="sapUiMediumMarginEnd">
                             <ObjectAttribute title="Trace Status" text="Active"/>
                        </l:VerticalLayout>
                    </l:HorizontalLayout>
                </f:DynamicPageHeader>
            </f:header>

            <f:content>
                <l:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMarginTop">
                    
                    <!-- LEFT: INPUT -->
                    <VBox class="sapUiSmallMargin">
                        <Panel headerText="Input Parameters" expandable="false" width="auto" class="sapUiResponsiveMargin">
                            <VBox class="sapUiSmallMargin">
                                
                                <Label text="Scenario" required="true"/>
                                <Select id="scenarioSelect" 
                                    selectedKey="{view>/scenario}" 
                                    forceSelection="false" 
                                    width="100%"
                                    items="{path: '/Scenarios', sorter: { path: 'name' }}"
                                    change=".onScenarioChange">
                                    <core:Item key="{ID}" text="{name}"/>
                                </Select>
                                
                                <Label text="Correlation ID" class="sapUiSmallMarginTop"/>
                                <Input value="{view>/correlationId}" placeholder="Trace ID (optional)"/>
                                
                                <Label text="Payload (JSON)" class="sapUiSmallMarginTop" required="true"/>
                                <TextArea value="{view>/payload}" rows="15" width="100%" placeholder="Enter JSON payload..." growing="true"/>
                            </VBox>
                        </Panel>
                    </VBox>
                    
                    <!-- RIGHT: RESULT -->
                    <VBox class="sapUiSmallMargin">
                        <Panel headerText="Simulation Result" height="auto" width="auto" class="sapUiResponsiveMargin">
                             <content>
                                <IconTabBar id="resultTabs" expanded="true" class="sapUiResponsiveContentPadding">
                                    <items>
                                        <IconTabFilter text="Visual Summary" icon="sap-icon://it-host">
                                            <VBox visible="{= !!${view>/result/decision} }">
                                                <ObjectHeader
                                                    title="{view>/result/decision}"
                                                    number="{view>/result/finalScore}"
                                                    numberUnit="Score"
                                                    intro="Decision Result"
                                                    icon="{= ${view>/result/decision} === 'APPROVED' ? 'sap-icon://accept' : ${view>/result/decision} === 'REJECTED' ? 'sap-icon://decline' : 'sap-icon://alert' }"
                                                    iconActive="false"
                                                    backgroundDesign="Translucent">
                                                    <statuses>
                                                        <ObjectStatus text="{view>/result/confidence}% Confidence" state="Information" icon="sap-icon://machine-learning"/>
                                                        <ObjectStatus text="{view>/result/processingTimeMs} ms" state="None" icon="sap-icon://performance"/>
                                                    </statuses>
                                                </ObjectHeader>
                                                
                                                <Title text="Score Impact" class="sapUiSmallMarginTop"/>
                                                <ProgressIndicator 
                                                    percentValue="{view>/result/finalScore}" 
                                                    displayValue="{view>/result/finalScore}/100" 
                                                    showValue="true" 
                                                    state="{= ${view>/result/finalScore} >= 60 ? 'Success' : ${view>/result/finalScore} < 40 ? 'Error' : 'Warning' }"
                                                    height="1.5rem"
                                                    class="sapUiSmallMarginBottom"/>

                                                <Title text="Fired Rules" class="sapUiSmallMarginTop"/>
                                                <List items="{view>/result/rulesFired}" noDataText="No rules triggered">
                                                    <StandardListItem 
                                                        title="{view>ruleName}" 
                                                        description="{view>explanation}"
                                                        info="{= ${view>scoreModifier} > 0 ? '+' + ${view>scoreModifier} : ${view>scoreModifier} }" 
                                                        infoState="{= ${view>scoreModifier} > 0 ? 'Success' : 'Error' }"
                                                        icon="sap-icon://process"/>
                                                </List>
                                            </VBox>
                                            <IllustratedMessage illustrationType="sapIll-NoData" title="Ready to Simulate" description="Click Execute to see results" visible="{= !${view>/result/decision} }"/>
                                        </IconTabFilter>
                                        
                                        <IconTabFilter text="Raw JSON" icon="sap-icon://code-placeholder">
                                            <TextArea value="{view>/result/rawJson}" rows="20" width="100%" editable="false"/>
                                        </IconTabFilter>
                                    </items>
                                </IconTabBar>
                            </content>
                        </Panel>
                    </VBox>

                </l:Grid>
            </f:content>

            <f:footer>
                <OverflowToolbar>
                    <ToolbarSpacer/>
                    <Text text="DecisionCore AI - Created by Taha Khattari"/>
                    <ToolbarSpacer/>
                </OverflowToolbar>
            </f:footer>
        </f:DynamicPage>
    </App>
</mvc:View>
