<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core"
    controllerName="decisioncore.execute.controller.Main" displayBlock="true">
    
    <App>
        <f:DynamicPage headerExpanded="true" toggleHeaderOnTitleClick="true" showFooter="false" fitContent="true">
             <f:title>
                <f:DynamicPageTitle>
                    <f:heading>
                        <Title text="{i18n>pageTitle}"/>
                    </f:heading>
                    <f:expandedContent>
                         <Label text="{i18n>pageSubtitle}"/>
                    </f:expandedContent>
                    <f:actions>
                        <Button text="{i18n>loadSample}" icon="sap-icon://sys-help-2" press=".onLoadSample"/>
                        <Button text="{i18n>clear}" icon="sap-icon://reset" press=".onClear"/>
                        <Button text="{i18n>execute}" type="Emphasized" icon="sap-icon://media-play" press=".onEvaluate"/>
                    </f:actions>
                </f:DynamicPageTitle>
            </f:title>

            <f:header>
                <f:DynamicPageHeader pinnable="true">
                     <l:HorizontalLayout allowWrapping="true">
                        <l:VerticalLayout class="sapUiMediumMarginEnd">
                             <ObjectAttribute title="{i18n>selectedScenario}" text="{view>/scenario}"/>
                        </l:VerticalLayout>
                        <l:VerticalLayout class="sapUiMediumMarginEnd">
                             <ObjectAttribute title="{i18n>traceStatus}" text="{i18n>active}"/>
                        </l:VerticalLayout>
                    </l:HorizontalLayout>
                </f:DynamicPageHeader>
            </f:header>

            <f:content>
                <l:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="1" vSpacing="1" class="sapUiSmallMarginTop">
                    
                    <!-- LEFT: INPUT -->
                    <VBox class="sapUiSmallMargin">
                        <Panel headerText="{i18n>inputParameters}" expandable="false" width="auto" class="sapUiResponsiveMargin">
                            <VBox class="sapUiSmallMargin">
                                
                                <!-- Decision Template Selection -->
                                <Label text="{i18n>decisionTemplate}" class="sapUiTinyMarginBottom"/>
                                <Select id="templateSelect" 
                                    selectedKey="{view>/selectedTemplate}"
                                    forceSelection="false" 
                                    width="100%"
                                    change=".onTemplateChange">
                                    <core:Item key="" text="{i18n>selectTemplate}"/>
                                    <core:Item key="asset_lifecycle" text="📦 Asset Lifecycle Decision"/>
                                    <core:Item key="capex_budget" text="💼 Capex Budget Release"/>
                                    <core:Item key="credit_application" text="🏦 Credit Application Approval"/>
                                    <core:Item key="invoice_approval" text="📄 Invoice Auto-Approval"/>
                                    <core:Item key="generic_json" text="📋 Generic JSON Decision"/>
                                    <core:Item key="hr_promotion" text="👤 HR Promotion Eligibility"/>
                                    <core:Item key="it_access" text="🔐 IT Access Request"/>
                                    <core:Item key="kyc_compliance" text="🪪 KYC Compliance Check"/>
                                    <core:Item key="contract_renewal" text="📝 Contract Auto-Renewal"/>
                                    <core:Item key="maintenance_priority" text="🔧 Maintenance Order Priority"/>
                                    <core:Item key="quality_inspection" text="🔬 Quality Inspection Decision"/>
                                    <core:Item key="sales_discount" text="💰 Sales Discount Approval"/>
                                    <core:Item key="return_request" text="📦 Return Request Action"/>
                                    <core:Item key="fraud_detection" text="🔍 Transaction Fraud Detection"/>
                                    <core:Item key="vendor_risk" text="🤝 Vendor Procurement Risk"/>
                                    <core:Item key="supply_chain_risk" text="🚚 Supply Chain Risk Assessment"/>
                                    <core:Item key="travel_expense" text="✈️ Travel Expense Approval"/>
                                    <core:Item key="warehouse_transfer" text="📦 Warehouse Stock Transfer"/>
                                    <core:Item key="custom" text="✏️ Custom Payload"/>
                                </Select>
                                
                                <!-- Target Scenario Selection -->
                                <Label text="{i18n>targetScenario}" required="true" class="sapUiSmallMarginTop"/>
                                <Select id="scenarioSelect" 
                                    selectedKey="{view>/scenario}" 
                                    forceSelection="false" 
                                    width="100%"
                                    items="{
                                        path: '/Scenarios',
                                        sorter: [
                                            { path: 'sourceSystem', group: true },
                                            { path: 'displayName' }
                                        ]
                                    }"
                                    change=".onScenarioChange">
                                    <core:ListItem key="{ID}" text="{displayName}" additionalText="{sourceSystem}"/>
                                </Select>
                                <HBox class="sapUiTinyMarginTop" alignItems="Center">
                                    <core:Icon src="sap-icon://hint" size="0.875rem" color="#0854a0" class="sapUiTinyMarginEnd"/>
                                    <Text text="{i18n>scenariosAvailable}" wrapping="true"/>
                                </HBox>
                                
                                <!-- Execution Mode -->
                                <Label text="{i18n>executionMode}" class="sapUiSmallMarginTop"/>
                                <SegmentedButton selectedKey="{view>/executionMode}" width="100%">
                                    <items>
                                        <SegmentedButtonItem key="simulate" text="{i18n>simulate}" icon="sap-icon://simulate"/>
                                        <SegmentedButtonItem key="execute" text="{i18n>executeLive}" icon="sap-icon://media-play"/>
                                        <SegmentedButtonItem key="debug" text="{i18n>debugMode}" icon="sap-icon://developer-settings"/>
                                    </items>
                                </SegmentedButton>
                                
                                <Label text="{i18n>correlationId}" class="sapUiSmallMarginTop"/>
                                <Input value="{view>/correlationId}" placeholder="{i18n>correlationIdPlaceholder}"/>
                                
                                <Label text="{i18n>payloadJson}" class="sapUiSmallMarginTop" required="true"/>
                                <TextArea value="{view>/payload}" rows="12" width="100%" placeholder="{i18n>enterJsonPayload}" growing="true"/>
                                
                                <!-- Quick Actions -->
                                <HBox class="sapUiSmallMarginTop" justifyContent="SpaceBetween">
                                    <Button text="{i18n>validateJson}" icon="sap-icon://validate" press=".onValidateJson" type="Transparent"/>
                                    <Button text="{i18n>format}" icon="sap-icon://syntax" press=".onFormatJson" type="Transparent"/>
                                    <Button text="{i18n>copy}" icon="sap-icon://copy" press=".onCopyPayload" type="Transparent"/>
                                </HBox>
                            </VBox>
                        </Panel>
                    </VBox>
                    
                    <!-- RIGHT: RESULT -->
                    <VBox class="sapUiSmallMargin">
                        <Panel headerText="{i18n>simulationResult}" height="auto" width="auto" class="sapUiResponsiveMargin">
                             <content>
                                <IconTabBar id="resultTabs" expanded="true" class="sapUiResponsiveContentPadding">
                                    <items>
                                        <IconTabFilter text="{i18n>visualSummary}" icon="sap-icon://it-host">
                                            <VBox visible="{= !!${view>/result/decision} }">
                                                <ObjectHeader
                                                    title="{view>/result/decision}"
                                                    number="{view>/result/finalScore}"
                                                    numberUnit="{i18n>score}"
                                                    intro="{i18n>decisionResult}"
                                                    icon="{= ${view>/result/decision} === 'APPROVED' ? 'sap-icon://accept' : ${view>/result/decision} === 'REJECTED' ? 'sap-icon://decline' : 'sap-icon://alert' }"
                                                    iconActive="false"
                                                    backgroundDesign="Translucent">
                                                    <statuses>
                                                        <ObjectStatus text="{view>/result/confidence}% {i18n>confidence}" state="Information" icon="sap-icon://machine-learning"/>
                                                        <ObjectStatus text="{view>/result/processingTimeMs} ms" state="None" icon="sap-icon://performance"/>
                                                    </statuses>
                                                </ObjectHeader>
                                                
                                                <Title text="{i18n>scoreImpact}" class="sapUiSmallMarginTop"/>
                                                <ProgressIndicator 
                                                    percentValue="{view>/result/finalScore}" 
                                                    displayValue="{view>/result/finalScore}/100" 
                                                    showValue="true" 
                                                    state="{= ${view>/result/finalScore} >= 60 ? 'Success' : ${view>/result/finalScore} &lt; 40 ? 'Error' : 'Warning' }"
                                                    height="1.5rem"
                                                    class="sapUiSmallMarginBottom"/>

                                                <Title text="{i18n>firedRules}" class="sapUiSmallMarginTop"/>
                                                <List items="{view>/result/rulesFired}" noDataText="{i18n>noRulesTriggered}">
                                                    <StandardListItem 
                                                        title="{view>ruleName}" 
                                                        description="{view>explanation}"
                                                        info="{= ${view>scoreModifier} > 0 ? '+' + ${view>scoreModifier} : ${view>scoreModifier} }" 
                                                        infoState="{= ${view>scoreModifier} > 0 ? 'Success' : 'Error' }"
                                                        icon="sap-icon://process"/>
                                                </List>
                                            </VBox>
                                            <VBox alignItems="Center" justifyContent="Center" visible="{= !${view>/result/decision} }" class="sapUiMediumMargin">
                                                <core:Icon src="sap-icon://simulate" size="4rem" color="#0854a0" class="sapUiSmallMarginBottom"/>
                                                <Title text="{i18n>readyToSimulate}" level="H3"/>
                                                <Text text="{i18n>clickExecute}" class="sapUiTinyMarginTop"/>
                                            </VBox>
                                        </IconTabFilter>
                                        
                                        <IconTabFilter text="{i18n>rawJson}" icon="sap-icon://code-placeholder">
                                            <TextArea value="{view>/result/rawJson}" rows="20" width="100%" editable="false"/>
                                        </IconTabFilter>
                                    </items>
                                </IconTabBar>
                            </content>
                        </Panel>
                    </VBox>

                </l:Grid>
            </f:content>
        </f:DynamicPage>
    </App>
</mvc:View>
