{
    "_version": "1.65.0",
    "sap.app": {
        "id": "decisioncore.history",
        "type": "application",
        "title": "Decision History",
        "description": "Audit Log and Execution Trace",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "dataSources": {
            "mainService": {
                "uri": "/api/decision/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "decisioncore.history.view.List",
            "type": "XML",
            "id": "app"
        },
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.layout": {},
                "sap.f": {},
                "sap.ui.export": {},
                "sap.ui.comp": {}
            }
        },
        "models": {
            "": {
                "dataSource": "mainService",
                "preload": false,
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": false
                }
            },
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "decisioncore.history.i18n.i18n",
                    "supportedLocales": [
                        "en",
                        "de",
                        "es",
                        "fr",
                        "it",
                        "ja",
                        "nl",
                        "zh"
                    ],
                    "fallbackLocale": "en"
                }
            }
        }
    }
}