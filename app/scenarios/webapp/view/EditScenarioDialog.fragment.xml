<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog title="Edit Scenario Configuration" id="editScenarioDialog">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
                <Label text="Scenario ID"/>
                <Input value="{editScenario>/name}" editable="false"/>
                
                <Label text="Display Name"/>
                <Input value="{editScenario>/displayName}"/>
                
                <Label text="Description"/>
                <TextArea value="{editScenario>/description}" rows="3"/>
                
                <Label text="Rules Weight (%)" />
                <VBox>
                    <Slider value="{editScenario>/rulesWeight}" min="0" max="100" width="100%" showAdvancedTooltip="true" progress="true"/>
                    <Text text="Determines how much business rules contribute to final score." class="sapUiTinyMarginTop sapUiTinyMarginBottom" />
                </VBox>

                <Label text="AI Weight (%)" />
                <Slider value="{editScenario>/aiWeight}" min="0" max="100" width="100%" showAdvancedTooltip="true" progress="true"/>

                <Label text="Auto-Approval Threshold"/>
                <Input value="{editScenario>/approvalThreshold}" type="Number" description="Score"/>

                <Label text="Review Threshold"/>
                <Input value="{editScenario>/reviewThreshold}" type="Number" description="Score"/>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="Save" type="Emphasized" press=".onEditScenarioSave"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onEditScenarioCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
