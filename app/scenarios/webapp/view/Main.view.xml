<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" 
    xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout"
    controllerName="decisioncore.scenarios.controller.Main" displayBlock="true">
    
    <App id="app">
        <f:DynamicPage headerExpanded="true" toggleHeaderOnTitleClick="true" showFooter="false">
            <!-- Dynamic Title -->
            <f:title>
                <f:DynamicPageTitle>
                    <f:heading>
                        <Title text="{i18n>pageTitle}"/>
                    </f:heading>
                    <f:expandedContent>
                        <Label text="{i18n>pageSubtitle}"/>
                    </f:expandedContent>
                    <f:snappedContent>
                        <Label text="{i18n>pageSubtitle}"/>
                    </f:snappedContent>
                    <f:content>
                        <OverflowToolbar>
                            <GenericTag text="{i18n>systemStatus}" status="{= ${stats>/systemStatus} === 'Online' ? 'Success' : 'Error'}" press="onPressOpenPopover">
                                <ObjectNumber number="{stats>/systemStatus}" state="{= ${stats>/systemStatus} === 'Online' ? 'Success' : 'Error'}"/>
                            </GenericTag>
                        </OverflowToolbar>
                    </f:content>
                    <f:actions>
                        <Button text="{i18n>createScenario}" type="Emphasized" icon="sap-icon://add" press=".onCreateScenario"/>
                        <Button icon="sap-icon://action" type="Transparent" press=".onGenericAction"/>
                    </f:actions>
                </f:DynamicPageTitle>
            </f:title>

            <!-- Dynamic Header -->
            <f:header>
                <f:DynamicPageHeader pinnable="true">
                    <layout:HorizontalLayout allowWrapping="true">
                        <layout:VerticalLayout class="sapUiMediumMarginEnd">
                            <ObjectAttribute title="{i18n>totalScenarios}" text="{stats>/totalScenarios}"/>
                        </layout:VerticalLayout>
                        <layout:VerticalLayout class="sapUiMediumMarginEnd">
                            <ObjectAttribute title="{i18n>statusActive}" text="{stats>/activeScenarios}"/>
                        </layout:VerticalLayout>
                        <layout:VerticalLayout class="sapUiMediumMarginEnd">
                            <ObjectAttribute title="{i18n>statusDraft}" text="{stats>/draftScenarios}"/>
                        </layout:VerticalLayout>
                        <layout:VerticalLayout class="sapUiMediumMarginEnd">
                            <ObjectAttribute title="{i18n>statusInactive}" text="{stats>/inactiveScenarios}"/>
                        </layout:VerticalLayout>
                    </layout:HorizontalLayout>
                </f:DynamicPageHeader>
            </f:header>

            <!-- Content Area -->
            <f:content>
                <Table id="scenariosTable" mode="MultiSelect" items="{/Scenarios}" sticky="ColumnHeaders,HeaderToolbar" inset="false" class="sapFDynamicPageAlignContent" width="auto" growing="true" growingThreshold="50">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>allScenarios}" level="H2"/>
                            <ToolbarSpacer/>
                            <SearchField width="300px" placeholder="{i18n>searchPlaceholder}" search=".onSearch" liveChange=".onSearch"/>
                            <Button icon="sap-icon://sort" type="Transparent" press=".onSort" tooltip="{i18n>sort}"/>
                            <Button icon="sap-icon://filter" type="Transparent" press=".onFilter" tooltip="{i18n>filter}"/>
                            <ToolbarSeparator/>
                            <Button icon="sap-icon://duplicate" type="Transparent" text="{i18n>duplicate}" press=".onDuplicateSelectedScenarios" tooltip="{i18n>duplicateSelected}"/>
                            <Button icon="sap-icon://delete" type="Transparent" text="{i18n>delete}" press=".onDeleteSelectedScenarios"/>
                            <Button icon="sap-icon://refresh" type="Transparent" press=".onRefresh" tooltip="{i18n>refresh}"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column><Text text="{i18n>colScenario}"/></Column>
                        <Column width="8rem"><Text text="{i18n>colSource}"/></Column>
                        <Column width="9rem" hAlign="Center"><Text text="{i18n>colStatus}"/></Column>
                        <Column hAlign="End" width="6rem"><Text text="{i18n>colRulesWeight}"/></Column>
                        <Column hAlign="End" width="6rem"><Text text="{i18n>colAiWeight}"/></Column>
                        <Column hAlign="Center" width="5rem"><Text text="{i18n>colVersion}"/></Column>
                        <Column hAlign="End" width="10rem"><Text text="{i18n>colActions}"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation" press=".onScenarioPress">
                            <cells>
                                <ObjectIdentifier title="{displayName}" text="{name}"/>
                                <Text text="{sourceSystem}"/>
                                <Select selectedKey="{status}" change=".onScenarioStatusChange" forceSelection="true">
                                    <core:Item key="ACTIVE" text="{i18n>statusActive}"/>
                                    <core:Item key="INACTIVE" text="{i18n>statusInactive}"/>
                                    <core:Item key="DRAFT" text="{i18n>statusDraft}"/>
                                </Select>
                                <ObjectNumber number="{rulesWeight}" unit="%" state="Information"/>
                                <ObjectNumber number="{aiWeight}" unit="%" state="None"/>
                                <ObjectStatus text="v{version}" state="Indication06"/>
                                <HBox justifyContent="End">
                                    <Button icon="sap-icon://duplicate" type="Transparent" press=".onDuplicateScenario" tooltip="{i18n>duplicate}"/>
                                    <Button icon="sap-icon://edit" type="Transparent" press=".onEditScenario" tooltip="{i18n>edit}"/>
                                    <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteScenario" tooltip="{i18n>delete}"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </f:content>

        </f:DynamicPage>
    </App>
</mvc:View>
