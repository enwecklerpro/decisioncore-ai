<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <SelectDialog
        id="templateSelectDialog"
        title="Select Decision Template"
        class="sapUiPopupWithPadding"
        items="{scenarioTemplates>/templates}"
        search=".onTemplateSearch"
        confirm=".onTemplateConfirm"
        cancel=".onTemplateCancel"
        contentWidth="700px"
        growing="true"
        growingThreshold="20">
        <StandardListItem
            title="{scenarioTemplates>name}"
            description="{scenarioTemplates>description}"
            icon="{scenarioTemplates>icon}"
            info="{scenarioTemplates>category}"
            infoState="Information"
            type="Active" />
    </SelectDialog>
</core:FragmentDefinition>
